# Copy to .env to override. Every value shown is optional: the defaults work with the
# backend running on http://127.0.0.1:8000.

# Where the Vite dev server forwards /api and /health (dev + `npm run preview` only).
BACKEND_URL=http://127.0.0.1:8000

# Base URL the browser uses for API calls. Leave EMPTY to call the same origin (the Vite
# proxy above). Only set this if the backend is served from elsewhere AND allows CORS
# (e.g. a production build behind a reverse proxy that serves both under one origin).
VITE_API_BASE_URL=

# Client-side timeout for a diagnosis, in milliseconds. The first request after the LLM
# was unloaded can take minutes; warm requests take 3-7 s.
VITE_REQUEST_TIMEOUT_MS=190000
