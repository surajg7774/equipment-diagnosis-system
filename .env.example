# Copy to .env and adjust. Values shown are the built-in defaults (GROQ_API_KEY has none:
# it is a secret you must supply yourself, and .env is git-ignored).

ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite for dev. For PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/servicediagnose
DATABASE_URL=sqlite:///./servicediagnose.db

CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=equipment_issues
KNOWLEDGE_BASE_PATH=data/knowledge_base.json

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Number of similar past cases to retrieve
TOP_K=3
# Minimum similarity (0-1) for the best match to count as a "close match".
# Below it the LLM gets no examples, diagnoses from general knowledge, and the
# response carries a note saying so.
LOW_CONFIDENCE_THRESHOLD=0.50

# --- Which LLM answers: "ollama" (local development, default) or "groq" (deployment) ---
LLM_PROVIDER=ollama

# --- Groq (hosted; used when LLM_PROVIDER=groq). Get a key at https://console.groq.com ---
# Set this ONLY in your real .env / hosting dashboard. Never commit a real value.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# llama-3.1-70b-versatile / llama-3.3-70b-versatile are not on every account's model list;
# list yours with: GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss models "think" before answering; low keeps it fast. Leave EMPTY for non-reasoning models.
GROQ_REASONING_EFFORT=low

# --- Image analysis: a vision-language model describes visible damage in uploaded photos ---
# "groq" (uses GROQ_API_KEY above) or "none" to switch /diagnose-image off.
VISION_PROVIDER=groq
# Must accept image input. List models and check `input_modalities`:
#   GET https://api.groq.com/openai/v1/models
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# 0 = most repeatable verdicts for the same photo
VISION_TEMPERATURE=0
# Free tier: ~3 images/minute (about 2,000 input tokens each against 7,000/minute)

# --- Ollama (local; used when LLM_PROVIDER=ollama). Run `ollama pull llama3.2:3b` first. ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# How long Ollama keeps the model loaded in RAM between requests
OLLAMA_KEEP_ALIVE=30m
# Generous: the first request after the model was unloaded must load it from disk
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.2
# Reasoning models count their hidden thinking against this limit, hence 1024
LLM_MAX_TOKENS=1024

# --- Web / deployment ---
# Comma-separated origins allowed to call the API from a browser (CORS).
# In production: your deployed frontend, e.g. https://my-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Rebuild the knowledge base at startup if it is empty (ephemeral hosts such as Render free)
AUTO_SEED_ON_STARTUP=true
# "onnx" (default, ~210 MB RAM) or "sentence-transformers" (PyTorch, ~750 MB; extra install)
EMBEDDING_BACKEND=onnx

# 5 MB
MAX_IMAGE_SIZE_BYTES=5242880

# --- Rate limiting on /diagnose and /diagnose-image (in memory, per client; 0 = off) ---
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60
# How many reverse proxies sit in front of the app and add to X-Forwarded-For.
# 0 = use the connection's own address (right for local runs). On Render use 1.
RATE_LIMIT_PROXY_HOPS=0
